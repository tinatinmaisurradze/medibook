# ---- Front end (Vite). Leave empty to use the built-in mock API that runs in the browser ----
VITE_API_URL=

# ---- Back end (npm run server) ----
PORT=4000
# a long random string; REQUIRED when NODE_ENV=production (at least 32 characters)
JWT_SECRET=
# addresses of the web app that may call the API, separated by commas
ALLOWED_ORIGIN=http://localhost:5173
DATA_FILE=server/data/db.json
# set to true only when the server is behind a proxy that sets X-Forwarded-For
TRUST_PROXY=false
